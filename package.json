{
  "name": "laravel-cloud-axi",
  "version": "0.1.0",
  "description": "An agent-focused CLI for Laravel Cloud operations",
  "type": "module",
  "bin": {
    "laravel-cloud-axi": "bin/laravel-cloud-axi.js"
  },
  "files": [
