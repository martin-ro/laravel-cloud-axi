  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martin-ro/laravel-cloud-axi.git"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.11"
  }
}
